{
  "name": "synaptome",
  "version": "0.2.0",
  "private": true,
  "description": "Synaptome — local-first AI capability operating system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GalHillel/synaptome.git"
  },
  "homepage": "https://github.com/GalHillel/synaptome#readme",
  "bugs": {
    "url": "https://github.com/GalHillel/synaptome/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "synaptome": "apps/cli/bin/synaptome.mjs",
    "drelqavo": "apps/cli/bin/drelqavo.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "synaptome": "node apps/cli/bin/synaptome.mjs",
    "build": "node --disable-warning=ExperimentalWarning --import tsx scripts/build.ts",
    "ci": "node scripts/ci.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "axe-core": "^4.10.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  }
}
